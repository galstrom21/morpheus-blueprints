{
  "blueprint": {
    "name": "PowerDNS 3-Node Cluster",
    "description": "Three-node PowerDNS authoritative DNS cluster on Ubuntu 24.04 LTS, CIS Level 1 hardened. Each node runs a local SQLite3 backend. Node 1 (primary) is the zone authority; Nodes 2 and 3 (secondaries) replicate zones via AXFR/NOTIFY using the PowerDNS autosecondary mechanism.",
    "type": "morpheus",
    "config": {
      "tiers": {
        "pdns-primary": {
          "linkedTiers": [],
          "tierIndex": 1,
          "instances": [
            {
              "instance": {
                "type": "ubuntu",
                "name": "${app.name}-pdns-01",
                "description": "PowerDNS Primary Node (SQLite3 backend + pdns-server, zone authority)",
                "layout": {
                  "code": "ubuntu-2404-single",
                  "id": 0
                },
                "plan": {
                  "code": "vm-2048"
                },
                "config": {
                  "createUser": true,
                  "resourcePoolId": null,
                  "smbiosAssetTag": null,
                  "nestedVirtualization": null,
                  "vmwareFolderId": null
                },
                "volumes": [
                  {
                    "rootVolume": true,
                    "name": "root",
                    "size": 40,
                    "storageType": 1
                  }
                ],
                "networkInterfaces": [
                  {
                    "primaryInterface": true,
                    "network": {
                      "idName": "Management",
                      "pool": {
                        "idName": "Default Pool"
                      }
                    },
                    "ipMode": "dhcp"
                  }
                ],
                "taskSet": {
                  "name": "pdns-primary-setup"
                }
              }
            }
          ]
        },
        "pdns-secondary": {
          "linkedTiers": ["pdns-primary"],
          "tierIndex": 2,
          "instances": [
            {
              "instance": {
                "type": "ubuntu",
                "name": "${app.name}-pdns-02",
                "description": "PowerDNS Secondary Node 2 (SQLite3 backend + pdns-server, AXFR replica)",
                "layout": {
                  "code": "ubuntu-2404-single",
                  "id": 0
                },
                "plan": {
                  "code": "vm-2048"
                },
                "config": {
                  "createUser": true,
                  "resourcePoolId": null
                },
                "volumes": [
                  {
                    "rootVolume": true,
                    "name": "root",
                    "size": 40,
                    "storageType": 1
                  }
                ],
                "networkInterfaces": [
                  {
                    "primaryInterface": true,
                    "network": {
                      "idName": "Management",
                      "pool": {
                        "idName": "Default Pool"
                      }
                    },
                    "ipMode": "dhcp"
                  }
                ],
                "taskSet": {
                  "name": "pdns-secondary-setup"
                }
              }
            },
            {
              "instance": {
                "type": "ubuntu",
                "name": "${app.name}-pdns-03",
                "description": "PowerDNS Secondary Node 3 (SQLite3 backend + pdns-server, AXFR replica)",
                "layout": {
                  "code": "ubuntu-2404-single",
                  "id": 0
                },
                "plan": {
                  "code": "vm-2048"
                },
                "config": {
                  "createUser": true,
                  "resourcePoolId": null
                },
                "volumes": [
                  {
                    "rootVolume": true,
                    "name": "root",
                    "size": 40,
                    "storageType": 1
                  }
                ],
                "networkInterfaces": [
                  {
                    "primaryInterface": true,
                    "network": {
                      "idName": "Management",
                      "pool": {
                        "idName": "Default Pool"
                      }
                    },
                    "ipMode": "dhcp"
                  }
                ],
                "taskSet": {
                  "name": "pdns-secondary-setup"
                }
              }
            }
          ]
        }
      },
      "options": [
        {
          "name": "pdns_api_key",
          "label": "PowerDNS API Key",
          "description": "API key for the PowerDNS HTTP API",
          "type": "password",
          "required": true,
          "defaultValue": "",
          "fieldName": "pdns_api_key",
          "fieldContext": "config"
        },
        {
          "name": "pdns_recursor_enable",
          "label": "Enable PowerDNS Recursor",
          "description": "Install and configure pdns-recursor on all nodes",
          "type": "checkbox",
          "required": false,
          "defaultValue": "off",
          "fieldName": "pdns_recursor_enable",
          "fieldContext": "config"
        },
        {
          "name": "cis_grub_password_hash",
          "label": "GRUB Bootloader Password Hash (CIS 1.4.1)",
          "description": "Optional. Provide a GRUB2 pbkdf2 password hash (generated with grub-mkpasswd-pbkdf2) to set a bootloader password per CIS 1.4.1. Leave blank to skip.",
          "type": "password",
          "required": false,
          "defaultValue": "",
          "fieldName": "cis_grub_password_hash",
          "fieldContext": "config"
        }
      ]
    }
  }
}
